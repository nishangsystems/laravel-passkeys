{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nishangsystems/laravel-passkeys",
    "type": "library",
    "description": "A reusable Laravel package for WebAuthn passkey authentication",
    "keywords": [
        "laravel",
        "passkeys",
        "webauthn",
        "authentication"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Kofi Mokome",
            "email": "kofimokome10@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "web-auth/webauthn-lib": "^5.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "symfony/uid": "^7.0",
        "nunomaduro/collision": "^8.8",
        "laravel/pint": "^1.22",
        "fakerphp/faker": "^1.24",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "NishangSystems\\Passkeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "NishangSystems\\Passkeys\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NishangSystems\\Passkeys\\PasskeysServiceProvider"
            ],
            "aliases": {
                "Passkey": "NishangSystems\\Passkeys\\Facades\\Passkey"
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "pint:fix": [
            "vendor/bin/pint --preset psr12"
        ],
        "pint": [
            "vendor/bin/pint --preset psr12 --test"
        ],
        "phpmd": [
            "vendor/bin/phpmd src text phpmd.xml"
        ],
        "phpstan": "phpstan analyse src --memory-limit=2048M --level=5",
        "phpcs:fix": "phpcbf",
        "phpcs": "phpcs",
        "test": "vendor/bin/testbench package:test --coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

